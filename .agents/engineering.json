{
  "schema": "eng-config/v1",
  "project": "omnie-dev-editor-engine",
  "commands": {
    "fast": [
      {
        "name": "swiftlint",
        "run": "swiftlint --strict",
        "timeout": 300
      },
      {
        "name": "test",
        "run": "xcodebuild test -scheme Runestone -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 16 Pro'",
        "timeout": 3600
      }
    ],
    "full": [
      {
        "name": "swiftlint",
        "run": "swiftlint --strict",
        "timeout": 300
      },
      {
        "name": "test",
        "run": "xcodebuild test -scheme Runestone -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 16 Pro'",
        "timeout": 3600
      }
    ]
  },
  "security": {
    "required": [
      "gitleaks",
      "semgrep"
    ],
    "optional": [
      "osv-scanner",
      "actionlint"
    ],
    "gitleaks_config": ".agents/config/gitleaks.toml",
    "semgrep_config": ".agents/config/semgrep.yml",
    "gitleaks_history": false,
    "timeout": 600
  },
  "budgets": {
    "fast_seconds": 3600,
    "full_seconds": 3600
  },
  "parallel": {
    "max_worktrees": 4
  },
  "impact": {
    "base": "origin/main"
  }
}
